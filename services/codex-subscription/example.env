# Copy to the ignored .env.local beside this file, restrict permissions,
# and fill a random token. Never commit the populated file.
CODEX_SUBSCRIPTION_GATEWAY_TOKEN=
CODEX_SUBSCRIPTION_BIND_HOST=127.0.0.1
CODEX_SUBSCRIPTION_PORT=8789
CODEX_SUBSCRIPTION_CONCURRENCY=1
CODEX_SUBSCRIPTION_MAX_QUEUE=8
CODEX_SUBSCRIPTION_TIMEOUT_MS=300000
CODEX_SUBSCRIPTION_EXECUTABLE=codex
CODEX_SUBSCRIPTION_MODEL=gpt-6.1-sol
CODEX_SUBSCRIPTION_EFFORT=high
# Optional task override: CODEX_SUBSCRIPTION_READING_MODEL=gpt-6.1-sol
# Sign in with ChatGPT using codex login. Never configure an API key here.
