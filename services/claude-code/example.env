# Copy to .env.local in this directory. Keep credentials out of Git.
# Generate a separate gateway secret with: openssl rand -hex 32
CLAUDE_CODE_GATEWAY_TOKEN=replace-with-a-random-token-of-at-least-32-characters
CLAUDE_CODE_BIND_HOST=127.0.0.1
CLAUDE_CODE_PORT=8789
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_CONCURRENCY=1
CLAUDE_CODE_MAX_QUEUE=8
CLAUDE_CODE_TIMEOUT_MS=300000

# Optional per-task models (aliases or pinned IDs accepted by your subscription):
# CLAUDE_CODE_READING_MODEL=opus
# CLAUDE_CODE_FOLLOWUP_MODEL=sonnet
# CLAUDE_CODE_FOLLOWUP_REPAIR_MODEL=sonnet
# CLAUDE_CODE_QUESTION_MODEL=sonnet
# CLAUDE_CODE_JOURNAL_SUMMARY_MODEL=sonnet

# Use this OS user's normal claude auth login credentials.
# CLAUDE_CODE_OAUTH_TOKEN overrides are unsupported and must remain unset.
