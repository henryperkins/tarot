{
  // Spacefast inspects the selected app's platform profile before building.
  // This entry is generated by build.mjs; it need not exist before the build.
  // Keep this supported Functions profile separate from root wrangler.jsonc.
  "name": "tableu-spacefast",
  "main": "dist/.server/handler.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tableu-spacefast",
      "migrations_dir": "dist/.server/migrations"
    }
  ]
}
